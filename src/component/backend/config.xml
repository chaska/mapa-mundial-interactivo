<?xml version="1.0" encoding="utf-8"?>
<config>
	<fieldset name="photos" label="COM_MAPAVIAJES_CONFIG_PHOTOS" description="COM_MAPAVIAJES_CONFIG_PHOTOS_DESC">
		<field name="max_photos" type="number" label="COM_MAPAVIAJES_CONFIG_MAX_PHOTOS" description="COM_MAPAVIAJES_CONFIG_MAX_PHOTOS_DESC" default="5" min="1" max="10" step="1" filter="integer" validate="number" />
		<field name="long_side" type="list" label="COM_MAPAVIAJES_CONFIG_LONG_SIDE" description="COM_MAPAVIAJES_CONFIG_LONG_SIDE_DESC" default="1000" filter="integer">
			<option value="800">800 px</option>
			<option value="1000">1000 px</option>
			<option value="1600">1600 px</option>
		</field>
		<field name="webp_quality" type="number" label="COM_MAPAVIAJES_CONFIG_QUALITY" description="COM_MAPAVIAJES_CONFIG_QUALITY_DESC" default="80" min="50" max="95" step="1" filter="integer" validate="number" />
		<field name="upload_max_mb" type="number" label="COM_MAPAVIAJES_CONFIG_UPLOAD_MB" description="COM_MAPAVIAJES_CONFIG_UPLOAD_MB_DESC" default="10" min="1" max="20" step="1" filter="integer" validate="number" />
		<field name="max_words" type="number" label="COM_MAPAVIAJES_CONFIG_MAX_WORDS" description="COM_MAPAVIAJES_CONFIG_MAX_WORDS_DESC" default="256" min="20" max="500" step="1" filter="integer" validate="number" />
		<field name="storage_path" type="text" label="COM_MAPAVIAJES_CONFIG_STORAGE" description="COM_MAPAVIAJES_CONFIG_STORAGE_DESC" default="" filter="string" size="60" />
	</fieldset>

	<fieldset name="moderation" label="COM_MAPAVIAJES_CONFIG_MODERATION" description="COM_MAPAVIAJES_CONFIG_MODERATION_DESC">
		<field name="review_first" type="radio" layout="joomla.form.field.radio.switcher" label="COM_MAPAVIAJES_CONFIG_REVIEW_FIRST" description="COM_MAPAVIAJES_CONFIG_REVIEW_FIRST_DESC" default="1" filter="integer">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field name="trips_per_hour" type="number" label="COM_MAPAVIAJES_CONFIG_PER_HOUR" description="COM_MAPAVIAJES_CONFIG_PER_HOUR_DESC" default="3" min="1" max="50" step="1" filter="integer" validate="number" />
		<field name="trips_per_day" type="number" label="COM_MAPAVIAJES_CONFIG_PER_DAY" description="COM_MAPAVIAJES_CONFIG_PER_DAY_DESC" default="10" min="1" max="200" step="1" filter="integer" validate="number" />
		<field name="reactions_per_day" type="number" label="COM_MAPAVIAJES_CONFIG_REACTIONS_DAY" description="COM_MAPAVIAJES_CONFIG_REACTIONS_DAY_DESC" default="300" min="10" max="5000" step="10" filter="integer" validate="number" />
		<field name="admin_self_react" type="list" label="COM_MAPAVIAJES_CONFIG_ADMIN_SELF_REACT" description="COM_MAPAVIAJES_CONFIG_ADMIN_SELF_REACT_DESC" default="1" filter="integer">
			<option value="0">COM_MAPAVIAJES_CONFIG_SELF_REACT_NO</option>
			<option value="1">COM_MAPAVIAJES_CONFIG_SELF_REACT_ADMIN</option>
			<option value="2">COM_MAPAVIAJES_CONFIG_SELF_REACT_ALL</option>
		</field>
		<field name="comments_provider" type="list" label="COM_MAPAVIAJES_CONFIG_COMMENTS_PROVIDER" description="COM_MAPAVIAJES_CONFIG_COMMENTS_PROVIDER_DESC" default="none" filter="word">
			<option value="none">COM_MAPAVIAJES_CONFIG_PROVIDER_NONE</option>
			<option value="engage">COM_MAPAVIAJES_CONFIG_PROVIDER_ENGAGE</option>
			<option value="events">COM_MAPAVIAJES_CONFIG_PROVIDER_EVENTS</option>
		</field>
		<field name="comments_default" type="radio" layout="joomla.form.field.radio.switcher" label="COM_MAPAVIAJES_CONFIG_COMMENTS_DEFAULT" description="COM_MAPAVIAJES_CONFIG_COMMENTS_DEFAULT_DESC" default="1" filter="integer">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
	</fieldset>

	<fieldset name="ranking" label="COM_MAPAVIAJES_CONFIG_RANKING" description="COM_MAPAVIAJES_CONFIG_RANKING_DESC">
		<field name="rank_enabled" type="radio" layout="joomla.form.field.radio.switcher" label="COM_MAPAVIAJES_CONFIG_RANK_ENABLED" description="COM_MAPAVIAJES_CONFIG_RANK_ENABLED_DESC" default="1" filter="integer">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field name="rank_w_trip" type="number" label="COM_MAPAVIAJES_CONFIG_RANK_W_TRIP" description="COM_MAPAVIAJES_CONFIG_RANK_W_DESC" default="20" min="0" max="1000" step="1" filter="integer" validate="number" />
		<field name="rank_w_photo" type="number" label="COM_MAPAVIAJES_CONFIG_RANK_W_PHOTO" description="COM_MAPAVIAJES_CONFIG_RANK_W_DESC" default="3" min="0" max="1000" step="1" filter="integer" validate="number" />
		<field name="rank_w_like" type="number" label="COM_MAPAVIAJES_CONFIG_RANK_W_LIKE" description="COM_MAPAVIAJES_CONFIG_RANK_W_DESC" default="1" min="0" max="1000" step="1" filter="integer" validate="number" />
		<field name="rank_w_comment" type="number" label="COM_MAPAVIAJES_CONFIG_RANK_W_COMMENT" description="COM_MAPAVIAJES_CONFIG_RANK_W_DESC" default="2" min="0" max="1000" step="1" filter="integer" validate="number" />
		<field name="rank_like_cap" type="number" label="COM_MAPAVIAJES_CONFIG_RANK_LIKE_CAP" description="COM_MAPAVIAJES_CONFIG_RANK_CAP_DESC" default="20" min="0" max="500" step="1" filter="integer" validate="number" />
		<field name="rank_comment_cap" type="number" label="COM_MAPAVIAJES_CONFIG_RANK_COMMENT_CAP" description="COM_MAPAVIAJES_CONFIG_RANK_CAP_DESC" default="20" min="0" max="500" step="1" filter="integer" validate="number" />
		<field name="notify_podium" type="radio" layout="joomla.form.field.radio.switcher" label="COM_MAPAVIAJES_CONFIG_NOTIFY_PODIUM" description="COM_MAPAVIAJES_CONFIG_NOTIFY_PODIUM_DESC" default="0" filter="integer">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
	</fieldset>

	<fieldset name="privacy" label="COM_MAPAVIAJES_CONFIG_PRIVACY" description="COM_MAPAVIAJES_CONFIG_PRIVACY_DESC">
		<field name="show_real_names" type="radio" layout="joomla.form.field.radio.switcher" label="COM_MAPAVIAJES_CONFIG_REAL_NAMES" description="COM_MAPAVIAJES_CONFIG_REAL_NAMES_DESC" default="0" filter="integer">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
	</fieldset>

	<fieldset name="notifications" label="COM_MAPAVIAJES_CONFIG_NOTIFY" description="COM_MAPAVIAJES_CONFIG_NOTIFY_DESC">
		<field name="notify_author" type="radio" layout="joomla.form.field.radio.switcher" label="COM_MAPAVIAJES_CONFIG_NOTIFY_AUTHOR" description="COM_MAPAVIAJES_CONFIG_NOTIFY_AUTHOR_DESC" default="1" filter="integer">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field name="notify_admin" type="radio" layout="joomla.form.field.radio.switcher" label="COM_MAPAVIAJES_CONFIG_NOTIFY_ADMIN" description="COM_MAPAVIAJES_CONFIG_NOTIFY_ADMIN_DESC" default="1" filter="integer">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field name="notify_emails" type="text" label="COM_MAPAVIAJES_CONFIG_NOTIFY_EMAILS" description="COM_MAPAVIAJES_CONFIG_NOTIFY_EMAILS_DESC" default="" filter="string" size="60" />
	</fieldset>

	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL" description="JCONFIG_PERMISSIONS_DESC">
		<field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" validate="rules" filter="rules" component="com_mapaviajes" section="component" />
	</fieldset>
</config>
