<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset>
		<field name="id" type="number" label="JGLOBAL_FIELD_ID_LABEL" default="0" readonly="true" class="readonly" />
		<field name="title" type="text" label="COM_MAPAVIAJES_COL_TITLE" required="true" maxlength="150" size="60" filter="string" />
		<field name="description" type="textarea" label="COM_MAPAVIAJES_ALBUM_FIELD_DESCRIPTION" rows="3" maxlength="2000" filter="string" />
		<field name="published" type="list" label="JSTATUS" default="1" class="form-select-color-state" validate="options">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="-2">JTRASHED</option>
		</field>
		<field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL" default="2" filter="integer" validate="options" />
		<field name="allow_comments" type="radio" layout="joomla.form.field.radio.switcher" label="COM_MAPAVIAJES_ALBUM_FIELD_COMMENTS" default="1" filter="integer">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" default="0" filter="integer" />
	</fieldset>
</form>
