<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field name="search" type="text" label="COM_MAPAVIAJES_FILTER_SEARCH" hint="JSEARCH_FILTER" />
		<field name="published" type="list" label="JSTATUS" onchange="this.form.submit();">
			<option value="">COM_MAPAVIAJES_FILTER_STATE</option>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="-2">JTRASHED</option>
			<option value="*">JALL</option>
		</field>
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="a.ordering ASC" onchange="this.form.submit();">
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.ordering ASC">JGRID_HEADING_ORDERING_ASC</option>
			<option value="a.title ASC">COM_MAPAVIAJES_COL_TITLE_ASC</option>
			<option value="a.title DESC">COM_MAPAVIAJES_COL_TITLE_DESC</option>
		</field>
		<field name="limit" type="limitbox" class="input-mini" default="25" onchange="this.form.submit();" />
	</fields>
</form>
